# ─────────────────────────────────────────────────────────────────────────────
# PaglaROUTER local development environment (copied to `.dev.vars`).
# Real values are NEVER committed. `wrangler dev` loads this file locally;
# production uses `npx wrangler secret put <NAME> --env production`.
# ─────────────────────────────────────────────────────────────────────────────

# Each secret may hold multiple accounts separated by commas:
#   GEMINI_API_KEY=key1,key2  → two weighted Google accounts.

GEMINI_API_KEY=
# GROQ_API_KEY=
# QWEN_API_KEY=
# KIMI_API_KEY=
# GITHUB_TOKEN=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Ecosystem aliases (claude-code-proxy / uni-api convention). Read-only:
# they are only used when the canonical `*_API_KEY` above is unset.
# GEMINI_API_KEYS=
# GROQ_API_KEYS=
# QWEN_API_KEYS=
# KIMI_API_KEYS=
# CEREBRAS_API_KEYS=
# MISTRAL_API_KEYS=
# OPENROUTER_API_KEYS=

# Authentication for /v1/* endpoints is fail-closed. Set this in local
# development and production to prevent the router from being an open proxy.
ROUTER_ADMIN_TOKEN=
# Optional comma-separated browser origins. If unset, the gateway sends no
# CORS allow-origin header; non-browser API clients remain unaffected.
# ROUTER_ALLOWED_ORIGINS=https://kolpona.paglaai.space,https://paglaai.space
# Maximum JSON request body size in bytes. Defaults to 1048576 (1 MiB).
# ROUTER_MAX_REQUEST_BYTES=1048576
